<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if page.title %}{{ page.title }} · {{ config.title }}{% else %}{{ config.title }}{% endif %}</title>
  <meta name="description" content="{{ config.description }}">
  <link rel="stylesheet" href="{{ url_for('css/style.css') }}">
  <link rel="alternate" type="application/atom+xml" href="{{ url_for('atom.xml') }}">
</head>
<body class="{% if is_home() %}page-home{% endif %}">
  <header class="site-header">
    <a class="brand" href="{{ url_for('/') }}">{{ theme.brand or config.title }}</a>
    <nav class="site-nav">
      {% for text, url in theme.menu %}
        <a href="{{ url_for(url) }}" {% if is_home() and text == 'Home' %}class="active"{% endif %}>{{ text }}</a>
      {% endfor %}
    </nav>
  </header>

  {{ body }}

  <footer class="site-footer">
    <p>{{ theme.footer_text }} · Powered by Hexo</p>
  </footer>
</body>
</html>
