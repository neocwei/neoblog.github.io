<section class="hero">
  <h1 class="hero-title">{{ theme.hero_title }}</h1>
  <p class="hero-subtitle">{{ theme.hero_subtitle }}</p>
  <a class="hero-link" href="{{ url_for('/archives/') }}">View all posts →</a>
  <div class="hero-scroll">▾</div>
</section>

<section class="content-list">
  <div class="container">
    {% set posts = site.posts.toArray() %}
    {% if posts.length > 0 %}
      {% set latest = posts[0] %}
      <a class="post-item" href="{{ url_for(latest.path) }}">
        <h2 class="post-item-title">{{ latest.title }}</h2>
        <time class="post-item-date">{{ date(latest.date, 'YYYY.MM.DD') }}</time>
      </a>
    {% endif %}
  </div>
</section>
