<section class="hero">
  <div class="hero-left">
    <h1 class="hero-title">{{ theme.hero_title }}</h1>
    <p class="hero-subtitle">{{ theme.hero_subtitle }}</p>
    <a class="hero-link" href="{{ url_for('/archives/') }}">View all posts →</a>
  </div>
  {% set posts = site.posts.toArray() %}
  {% if posts.length > 0 %}
    {% set latest = posts[0] %}
    <div class="hero-latest">
      <span class="hero-latest-label">Latest post</span>
      <a class="hero-latest-title" href="{{ url_for(latest.path) }}">{{ latest.title }}</a>
      <time class="hero-latest-date">{{ date(latest.date, 'YYYY.MM.DD') }}</time>
    </div>
  {% endif %}
</section>
