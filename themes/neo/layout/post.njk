<article class="post-page">
  <div class="container container-narrow">
    <h1 class="post-title">{{ page.title }}</h1>
    <time class="post-date">{{ date(page.date, 'YYYY.MM.DD') }}</time>
    {% if page.tags and page.tags.length %}
      <div class="post-tags">
        {% for tag in page.tags.toArray() %}<span># {{ tag.name }}</span>{% endfor %}
      </div>
    {% endif %}
    <div class="post-content">
      {{ page.content }}
    </div>
    <div class="post-nav">
      {% if page.prev %}<a href="{{ url_for(page.prev.path) }}">← {{ page.prev.title }}</a>{% endif %}
      {% if page.next %}<a class="right" href="{{ url_for(page.next.path) }}">{{ page.next.title }} →</a>{% endif %}
    </div>
  </div>
</article>
